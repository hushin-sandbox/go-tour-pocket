{
  "name": "go-tour-pocket",
  "private": true,
  "description": "A Tour of Go を英日対訳・オフラインで学べるスマホ向け PWA",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "prebuild": "pnpm build:wasm",
    "build:wasm": "bash wasm/build.sh",
    "e2e": "node scripts/e2e-app.mjs && node scripts/e2e-update.mjs",
    "e2e:update": "node scripts/e2e-update.mjs",
    "e2e:spike": "pnpm build && node scripts/e2e-spike.mjs",
    "check": "pnpm lint && pnpm fmt:check && pnpm build && wrangler deploy --dry-run --config wrangler.json",
    "deploy": "wrangler deploy --config wrangler.json",
    "dev": "vite",
    "predev": "pnpm build:wasm",
    "lint": "oxlint && steiger ./src/react-app && depcruise src",
    "lint:fix": "oxlint --fix && steiger ./src/react-app --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "pnpm run build && vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:deps": "depcruise src",
    "deps:graph": "depcruise src --output-type dot"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/tanstack-react": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.5.0",
    "lucide-react": "^1.52.0",
    "mockdate": "^3.0.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "skills": "1.7.2",
    "steiger": "^0.7.0",
    "storybook": "^10.6.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@12.3.4"
}
