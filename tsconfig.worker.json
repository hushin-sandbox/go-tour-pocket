{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "types": [
      "vite/client",
      "./worker-configuration.d.ts",
      "vitest/globals",
      "@cloudflare/vitest-plugin/types"
    ],

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/worker", "src/shared"]
}
